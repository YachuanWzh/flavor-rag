# ============================================================
# flavor-rag 环境变量参考 (v0.0.5)
# 复制此文件为 .env 并填入实际值
# ============================================================

# === 服务端 ===
SERVER_PORT=9090
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/flavorag
REDIS_URL=redis://:123456@127.0.0.1:6379/0
MILVUS_URI=http://localhost:19530

# 对象存储 (RustFS / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=flavorag-sources
SOURCE_STORAGE_BACKEND=local
SOURCE_STORAGE_PREFIX=sources

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 模型供应商 API Key
SILICONFLOW_API_KEY=sk-xxx
BAILIAN_API_KEY=sk-xxx

# Embedding
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_QUERY_TIMEOUT_SEC=25
EMBEDDING_QUERY_MAX_ATTEMPTS=2

# LLM
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus-latest
LLM_MAX_OUTPUT_TOKENS=2048
LLM_GENERATION_TIMEOUT_SEC=90
LLM_CONTEXT_WINDOW_TOKENS=8192
LLM_PROMPT_RESERVE_TOKENS=800
CODE_MODEL=deepseek-v3
DOC_MODEL=qwen-plus-latest

# 复杂 PDF 图片理解（仅入库阶段调用）
VLM_ENABLED=false
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=
VLM_MODEL=qwen-vl-plus
VLM_MAX_OUTPUT_TOKENS=800
VLM_MAX_CONCURRENCY=2

# 复杂 PDF 入库
PDF_TABLE_MAX_ROWS=20
PDF_IMAGE_MIN_AREA_RATIO=0.001
# true: 图片资产上传失败则整次入库失败，避免产生不可展示的残缺索引
PDF_ASSET_STORAGE_REQUIRED=true
PDF_OCR_ENABLED=true
PDF_OCR_MIN_NATIVE_CHARS=20
PDF_OCR_DPI=180

# Retrieval governance
RERANKER_ENABLED=true
RERANKER_TIMEOUT_SEC=15
RETRIEVAL_PER_CHANNEL_TOP_K=12
RETRIEVAL_MAX_CANDIDATES=40
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_CHANNEL_TIMEOUT_MS=30000
RETRIEVAL_TOTAL_TIMEOUT_MS=35000
RETRIEVAL_CONTEXT_MAX_CHARS=12000
RETRIEVAL_MIN_RELEVANCE_SCORE=0.01
RETRIEVAL_CHANNEL_WEIGHTS=vector:1.0,keyword:1.0,graph:0.8
QUERY_DECOMPOSITION_ENABLED=true
QUERY_DECOMPOSITION_MAX_QUERIES=3
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_RECOVERY_SEC=30

# Query understanding and answer recommendations
REWRITE_ENABLED=true
INTENT_LLM_ENABLED=true
INTENT_MIN_SCORE=0.3
INTENT_MAX_MATCHES=5
INTENT_GUIDANCE_MIN_SCORE=0.55
INTENT_GUIDANCE_SCORE_GAP=0.08
RECOMMENDED_QUESTIONS_ENABLED=true
RECOMMENDED_QUESTIONS_COUNT=3

# URL ingestion security
URL_INGESTION_MAX_BYTES=52428800
URL_INGESTION_TIMEOUT_SEC=120
URL_INGESTION_MAX_REDIRECTS=5
URL_ALLOW_PRIVATE_NETWORKS=false
UPLOAD_MAX_BYTES=52428800
UPLOAD_BATCH_MAX_FILES=20
UPLOAD_MAX_PDF_PAGES=500
ARCHIVE_MAX_UNCOMPRESSED_BYTES=209715200
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_COMPRESSION_RATIO=200
UPLOAD_MAX_IMAGE_PIXELS=100000000
PDF_OCR_MAX_CONCURRENCY=4

# Controlled Agentic RAG and tools
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=16
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=8
CONVERSATION_CONTEXT_MAX_TOKENS=2000
CHAT_MAX_INPUT_TOKENS=3000
AGENTIC_RAG_ENABLED=false
AGENT_MAX_STEPS=4
AGENT_TOOL_TIMEOUT_SEC=10
# Agentic 最终生成的重试/降级策略（总计最多 5 次）
# Primary 留空时复用 REASONING_MODEL/BASE_URL/API_KEY；
# Fallback 留空时依次复用 HYDE_*、MEM0_*。
AGENTIC_PRIMARY_MODEL=
AGENTIC_FALLBACK_MODEL=
# 如需为两个层级统一覆盖供应商，可显式配置以下端点和密钥。
AGENTIC_MODEL_BASE_URL=
AGENTIC_MODEL_API_KEY=
AGENTIC_PRIMARY_ATTEMPTS=3
AGENTIC_FALLBACK_ATTEMPTS=2
AGENTIC_RETRY_BASE_DELAY_SEC=1
AGENTIC_RETRY_MAX_DELAY_SEC=8
# Agentic 会先缓冲成功答案，再按小块回放以保留 SSE 打字机效果。
AGENTIC_REPLAY_CHUNK_CHARS=2
AGENTIC_REPLAY_INTERVAL_MS=18
SQL_TOOL_ENABLED=false
SQL_TOOL_ALLOWED_RELATIONS=
MCP_TOOL_ENABLED=false
MCP_ALLOWED_TOOLS=
MCP_TOOLS_JSON={}

# 深度思考 / 推理模型（开启深度思考时使用，需支持 reasoning_content 的模型）
# 例如 DeepSeek-R1: https://api.deepseek.com/v1, model=deepseek-reasoner
# 或 SiliconFlow: https://api.siliconflow.cn/v1, model=Pro/deepseek-ai/DeepSeek-R1
REASONING_MODEL=
REASONING_BASE_URL=
REASONING_API_KEY=

# Reranker
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# Elasticsearch（可选）
ES_URIS=http://127.0.0.1:9200
ES_ENABLED=true

# LightRAG + Neo4j（可选）
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
GRAPH_ENABLED=false
GRAPH_SEMANTIC_ENABLED=true
GRAPH_SEMANTIC_MODEL=qwen-plus-latest
GRAPH_SEMANTIC_BASE_URL=
GRAPH_SEMANTIC_API_KEY=
GRAPH_SEMANTIC_MAX_TOKENS=2048
GRAPH_SEMANTIC_MAX_INPUT_CHARS=4000
GRAPH_SEMANTIC_BATCH_CHUNKS=6
GRAPH_SEMANTIC_TIMEOUT_SEC=45
GRAPH_SEMANTIC_MIN_CONFIDENCE=0.70
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# RocketMQ（可选）
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# 限流（可选）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_USER_QPM=60
RATE_LIMIT_IP_QPM=600

# flavor-code 集成（可选）
FLAVOR_CODE_INTEGRATION_ENABLED=false
FLAVOR_CODE_API_TOKENS=

# HyDE（Hypothetical Document Embeddings）— 轻量模型生成假设文档辅助向量检索
HYDE_ENABLED=false
HYDE_MODEL=qwen-turbo-latest
HYDE_BASE_URL=
HYDE_API_KEY=
HYDE_MAX_TOKENS=512
HYDE_TEMPERATURE=0.7
HYDE_CHANNEL_WEIGHT=0.8
HYDE_TIMEOUT_SEC=15.0

# 可观测性与保留策略
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
OTEL_SERVICE_NAME=flavorag-server
PROMETHEUS_UI_URL=http://localhost:19090
GRAFANA_UI_URL=http://localhost:13000
JAEGER_UI_URL=http://localhost:16687
TRACE_STORE_CONTENT=false
TRACE_RETENTION_DAYS=30
INDEX_RETIRED_RETENTION_DAYS=7

# === 前端 ===
VITE_API_BASE_URL=
VITE_APP_NAME=RAG 智能问答
