{
  "uid": "flavorag-overview",
  "title": "FlavoRAG Overview",
  "tags": ["flavorag"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP QPS by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "sum by (path) (rate(flavorag_http_requests_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(flavorag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RAG runs by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(flavorag_rag_runs_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retrieval channel p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(flavorag_retrieval_channel_duration_seconds_bucket[5m])))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM time-to-first-token p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(flavorag_llm_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingestion queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "flavorag_ingestion_queue_depth",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingestion jobs finished / min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(flavorag_ingestion_jobs_total[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Open circuit breakers",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "sum(flavorag_circuit_breaker_open)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAG end-to-end p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flavorag_rag_end_to_end_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Missing active chunks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "flavorag-prometheus" },
      "targets": [
        {
          "expr": "flavorag_index_missing_chunks",
          "legendFormat": "{{kb_id}}"
        }
      ]
    }
  ]
}
